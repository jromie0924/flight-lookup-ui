# Copy this file to `.env` and fill in the values. `.env` is gitignored.

# Base URL of the flight-query API (API Gateway stage URL or custom domain).
# No trailing slash. The app requests `${VITE_API_BASE_URL}/flights`.
VITE_API_BASE_URL=https://api.example.com

# API key sent as the `x-api-key` header. Leave blank until the backend auth
# change (guidelines section 6) lands. If the backend uses a shared bearer
# token instead, update src/api/flights.ts to send `Authorization: Bearer ...`.
VITE_API_KEY=
